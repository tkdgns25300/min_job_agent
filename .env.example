# ─────────────────────────────────────────────────────────────
# Vertex AI (Gemini) — 구조화 AI. 본인 GCP 서비스계정 값 사용.
# PRIVATE_KEY의 줄바꿈은 \n(백슬래시 n)으로 한 줄로 넣는다.
# ─────────────────────────────────────────────────────────────
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=global
VERTEX_AI_CLIENT_EMAIL=
VERTEX_AI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 구조화 모델 — 기본값. `structure`·`check-gemini`가 옵션 없이 쓰는 모델이다.
VERTEX_MODEL=gemini-3.5-flash
# 값싼 대안 — `--lite`를 줄 때만 쓴다(입력 1/5 · 출력 1/3.6 가격).
# ⚠️ `--lite`인데 이 값이 비어 있으면 **비싼 모델로 몰래 도는 대신 실행이 멈춘다.**
VERTEX_MODEL_LITE=gemini-3.5-flash-lite

# ─────────────────────────────────────────────────────────────
# 저장소 — 원장을 어디에 쓰나
# ─────────────────────────────────────────────────────────────
# json(기본) | supabase. ⚠️ **명시하지 않으면 로컬 파일에 쓴다.**
# 오타는 조용히 기본값으로 떨어지지 않고 실행이 멈춘다(MINJOB_STORE=supabse → 오류).
MINJOB_STORE=json

# supabase 일 때만 필요. 아래 둘 중 하나라도 비면 **한 건도 쓰기 전에** 멈춘다.
# ⚠️ service_role 키는 RLS를 우회하는 전권이다 — 커밋·로그에 남기지 않는다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# 경로 (선택) — 미설정 시 리포 기준 기본값(minjob_ingest/paths.py)
# ─────────────────────────────────────────────────────────────
# 로컬 JSON 저장소 위치. 기본 <repo>/data
MINJOB_DATA_DIR=
# 소스 레지스트리 config 경로. 기본 <repo>/config/sources.json
MINJOB_SOURCES=

# 이단 참고 목록 (기본: config/heresy-ref.json)
# ⚠️ 실명 자료라 커밋하지 않는다 — 없으면 structure 가 시작 전에 멈춘다(SPEC §5.4).
MINJOB_HERESY_REF=
