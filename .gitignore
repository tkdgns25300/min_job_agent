# dependencies · 도구 산출물 (전부 자동 생성 — 지워도 다시 만들어진다)
.venv/
*.egg-info/

# python
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# build output
dist/
build/

# env (단일 .env만 사용, .env.example만 커밋)
.env
.env.*
!.env.example

# logs
*.log

# 크롤러 로컬 산출물·상태 (파이프라인 설계 후 조정)
/data/
/output/
*.local.json

# OS / editor
.DS_Store
.vscode/
.idea/

# fixture(게시판 HTML 원본) — 커밋하지 않는다.
# 원본에는 실제 연락처·실명이 있고 이 리포는 공개다. "마스킹해서 올린다"는 패턴이 완벽해야
# 성립하는데 실제로 구멍 2개로 3건이 새어나갔다(2026-08-04) → 아예 올리지 않는다(가드레일 #11).
# 받는 방법은 tests/fixtures/README.md.
tests/fixtures/*
!tests/fixtures/README.md

# 시간대 이관 등 일회성 백업 (재수집 90분 · 지우지 말 것)
data.*-backup-*/

# 이단 참고 목록 — 실명 122건이 담긴 민감 자료. **공개 리포이므로 커밋하지 않는다**
# (가드레일 #11). Supabase 전환 시 DB로 옮기고 RLS 운영자 전용으로 둔다.
config/heresy-ref.json
